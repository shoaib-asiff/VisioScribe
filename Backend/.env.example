# ==============================================================================
# VisioScribe Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
#
# Server Configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
# Note: The database name "VisioScribe" will be appended automatically by the connection utility.
MONGOATLASURL=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=visioscribe_jwt_access_secret_key_change_me_in_production
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=visioscribe_jwt_refresh_secret_key_change_me_in_production
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Storage (for image hosting)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer Gmail SMTP for OTP verification)
EMAIL=your_email@gmail.com
PASS=your_gmail_app_password

# Redis Cache Service (Local or Cloud Redis)
REDIS_NAME=
REDIS_PASS=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Model Inference Microservice Endpoint
MODEL_API=http://localhost:5000

# OpenRouter LLM API (for AI Caption Enhancement)
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
OPEN_ROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
SITE_NAME=VisioScribe

