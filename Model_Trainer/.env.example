# ==============================================================================
# VisioScribe Model Trainer Environment Configuration
# ==============================================================================
# DagsHub Repository Settings
DAGSHUB_REPO_OWNER=shoaib-asiff
DAGSHUB_REPO_NAME=VisioScribe
# Personal Access Token from https://dagshub.com/user/settings/tokens
DAGSHUB_TOKEN=your_dagshub_token_here

# Dataset Path
DATASET_CSV_PATH=dataset.csv

# MLflow Tracking & Registry
MLFLOW_TRACKING_URI=https://dagshub.com/shoaib-asiff/VisioScribe.mlflow
MLFLOW_EXPERIMENT_NAME=visioscribe-training
MLFLOW_RUN_NAME=visioscribe-blip-run
MODEL_NAME=VisioScribe-Caption-Model
MLFLOW_MODEL_STAGE=Staging

# Training Hyperparameters
BATCH_SIZE=2
NUM_EPOCHS=1
LEARNING_RATE=1e-5
WEIGHT_DECAY=1e-4
NUM_WORKERS=0

